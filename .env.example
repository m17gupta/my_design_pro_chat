# Copy to .env.local and fill in your keys.
# Provider: "openai" (default) or "anthropic"
AI_PROVIDER=openai

# API keys — add the one matching your provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# AWS S3 signed uploads (server-side only — never NEXT_PUBLIC_)
# The bucket (or the luna-ai/ prefix) must allow public reads, or the
# uploaded URLs 403 when rendered / sent to the design API.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# FastAPI design backend (server-side only — proxied via /api/design-brief
# and /api/design-status/{task_id}; the key never reaches the browser)
DESIGN_API_URL=http://localhost:8000/generate-design
# Base URL for status polling — the route appends /{task_id}
DESIGN_STATUS_API_URL=https://api.dzinlynxt.com/api/v1/luna/status
# API key sent as the `X-API-Key` header to the FastAPI backend
DESIGN_API_KEY=

# Supabase persistence — chat answers + design history are saved to
# public.luna_my_design_projects so a refresh restores the session.
# CRUD runs server-side via /api/projects: the browser only needs the project
# URL (for the config flag); the service-role key stays server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
