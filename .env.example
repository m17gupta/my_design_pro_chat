# Copy to .env.local and fill in your keys.
# Provider: "openai" (default) or "anthropic"
AI_PROVIDER=openai

# API keys — add the one matching your provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Cloudinary signed uploads (server-side only — never NEXT_PUBLIC_)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# FastAPI design backend (server-side only — proxied via /api/design-brief
# and /api/design-status/{task_id}; the key never reaches the browser)
DESIGN_API_URL=http://localhost:8000/generate-design
# Base URL for status polling — the route appends /{task_id}
DESIGN_STATUS_API_URL=https://api.dzinlynxt.com/api/v1/luna/status
# API key sent as the `X-API-Key` header to the FastAPI backend
DESIGN_API_KEY=
